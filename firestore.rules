rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products inventory collection
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.keys().hasAll(['sku', 'name', 'category', 'unit', 'quantity'])
        && request.resource.data.sku is string
        && request.resource.data.name is string
        && request.resource.data.quantity is number;
      allow update: if isSignedIn()
        && request.resource.data.quantity is number;
      allow delete: if isSignedIn();
    }

    // Transactions log collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['docNo', 'type', 'productId', 'quantity'])
        && request.resource.data.quantity is number;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Warehouses zones collection
    match /warehouses/{warehouseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || request.resource.data.email == request.auth.token.email);
    }
  }
}
